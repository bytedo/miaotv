{
  "name": "miaotv",
  "version": "6.6.6+1",
  "description": "Self-hosted video search and playback with TVBox and Emby support.",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bytedo/miaotv.git"
  },
  "engines": {
    "node": ">=22.23.2",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "pnpm gen:manifest && next dev -H 0.0.0.0",
    "dev:local": "node scripts/dev-local.cjs",
    "build": "pnpm gen:manifest && next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:watch": "node --test --watch src/lib/__tests__/*.test.cjs src/lib/__tests__/invite-code.test.ts src/app/api/__tests__/*.test.cjs",
    "test": "pnpm test:accounts",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "edgeone:build": "node scripts/edgeone-build.mjs",
    "prepare": "husky",
    "test:accounts": "node --test src/lib/__tests__/*.test.cjs src/lib/__tests__/invite-code.test.ts src/app/api/__tests__/*.test.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mui/material": "^9.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-virtual": "^3.14.11",
    "@types/crypto-js": "^4.2.2",
    "@upstash/redis": "^1.25.0",
    "@vercel/blob": "^2.0.1",
    "@websr/websr": "^0.0.16",
    "artplayer": "^5.4.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "bs58": "^6.0.0",
    "cacheable-lookup": "^7.0.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "flv.js": "^1.6.2",
    "framer-motion": "^13.2.0",
    "he": "^1.2.0",
    "hls.js": "^1.7.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.14.0",
    "md5": "^2.3.0",
    "mux.js": "^6.3.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pinyin-pro": "^3.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "redis": "^4.6.7",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "switch-chinese": "^1.0.16",
    "tailwind-merge": "^2.6.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.102.6",
    "@types/bs58": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/md5": "^2.3.6",
    "@types/node": "24.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.6",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^12.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "webpack-obfuscator": "^3.5.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "homepage": "https://github.com/bytedo/miaotv"
}
