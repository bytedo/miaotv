# 复制为 .env.local，再填写自己的配置。
# 完整说明：docs/deployment/CONFIGURATION.md

# 站长账号。PASSWORD 必须自行填写，没有默认密码。
USERNAME=admin
PASSWORD=
NEXT_PUBLIC_SITE_NAME=MiaoTV

# localstorage 用于浏览器本地数据；账号管理和跨设备同步需要服务端存储。
# 可选：localstorage、redis、kvrocks、upstash、sqlite。
# compose.yaml 会覆盖为 redis，并连接同组的 Redis 容器。
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# 按所选后端取消注释并填写，未使用的后端无需配置。
# REDIS_URL=redis://127.0.0.1:6379
# KVROCKS_URL=redis://127.0.0.1:6666
# UPSTASH_URL=https://your-database.upstash.io
# UPSTASH_TOKEN=

# 部署到域名后填写公开地址，供邮件链接等功能使用。
# SITE_BASE=https://tv.example.com

# 注册由管理后台的 UserConfig.AllowRegister 控制，没有对应的环境变量。
# 服务端存储新库默认允许注册，对外提供访问前请检查注册、审核和邀请码设置。
